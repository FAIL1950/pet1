{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@app/common": ["./packages/common/src/index.ts"],
      "@app/common/*": ["./packages/common/src/*"],
      "@app/contracts": ["./packages/contracts/src/index.ts"],
      "@app/contracts/*": ["./packages/contracts/src/*"]
    }
  },
  "files": [],
  "references": [
    { "path": "./services/auth/tsconfig.app.json" },
    { "path": "./services/boards/tsconfig.app.json" },
    { "path": "./services/notifications/tsconfig.app.json" }
  ]
}
