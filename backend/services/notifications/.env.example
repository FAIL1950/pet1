# Local run outside k8s: `skaffold dev` port-forwards Postgres (5432).
# Bun loads .env from the working directory, so copy this to backend/.env and run `bun run start:notifications:dev`.
PORT=3004
DATABASE_URL=postgres://notifications:notifications@localhost:5432/notifications
# Kafka via skaffold's port-forward; every replica uses the same group.
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=notifications
KAFKA_GROUP_ID=notifications
# Optional outgoing mail (Gmail: an app password, see k8s/smtp.secret.yaml.example).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# MAIL_FROM="pet-1 <you@gmail.com>"
