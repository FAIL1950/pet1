# Local run outside k8s: `skaffold dev` port-forwards Postgres (5432) and Kafka (9094).
# Bun loads .env from the working directory, so copy this to backend/.env and run `bun run start:auth:dev`.
PORT=3001
DATABASE_URL=postgres://auth:auth@localhost:5432/auth
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3001
TRUSTED_ORIGINS=http://localhost:3000,http://localhost
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=auth
# Optional: Google OAuth is enabled only when both are set.
# Redirect URI to register in Google Console: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
