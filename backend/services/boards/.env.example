# Local run outside k8s: `skaffold dev` port-forwards Postgres (5432), Kafka (9094) and auth (3001).
# Bun loads .env from the working directory, so copy this to backend/.env and run `bun run start:boards:dev`.
PORT=3003
DATABASE_URL=postgres://boards:boards@localhost:5432/boards
AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks
# Must equal auth's BETTER_AUTH_URL (JWT iss/aud).
AUTH_JWT_ISSUER=http://localhost:3001
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=boards
KAFKA_GROUP_ID=boards-projection
