# Copy to k8s/google-oauth.secret.yaml (gitignored) and fill in to enable Google sign-in.
# Google Console: OAuth client of type "Web application",
# redirect URI http://localhost/api/auth/callback/google.
apiVersion: v1
kind: Secret
metadata:
  name: google-oauth
  labels:
    app.kubernetes.io/name: auth
    app.kubernetes.io/part-of: pet-1
type: Opaque
stringData:
  GOOGLE_CLIENT_ID: ""
  GOOGLE_CLIENT_SECRET: ""
