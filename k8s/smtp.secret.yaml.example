# Outgoing mail for the notifications service (verification emails).
# Copy to k8s/smtp.secret.yaml (gitignored) and fill in. Gmail:
#   1. Turn on 2-Step Verification for the Google account.
#   2. Google Account -> Security -> App passwords -> create one (16 characters).
#   3. SMTP_USER / MAIL_FROM = the Gmail address, SMTP_PASS = the app password (not your Google password).
apiVersion: v1
kind: Secret
metadata:
  name: smtp
  labels:
    app.kubernetes.io/part-of: pet-1
type: Opaque
stringData:
  SMTP_HOST: smtp.gmail.com
  SMTP_PORT: "465"
  SMTP_USER: you@gmail.com
  SMTP_PASS: xxxxxxxxxxxxxxxx
  MAIL_FROM: "pet-1 <you@gmail.com>"
